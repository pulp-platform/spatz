// CNN layer on O-POPE (FP16 -> FP32): valid 3x3 convolution + bias + ReLU as im2col -> GeMM -> ReLU.
//   M = Ho*W (output rows, incl. kw-1 unused columns per image row), N = Cin*KH*KW, K = Cout.
{
    kernel: "CONV"
    Cin: 16,
    H: 14,
    W: 16,
    Cout: 32,
    KH: 3,
    KW: 3
}
