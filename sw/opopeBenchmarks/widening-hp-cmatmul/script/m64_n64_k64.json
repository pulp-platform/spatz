// Complex GeMM C[MxK] = A[MxN] * B[NxK] on O-POPE (FP16 -> FP32), complex data interleaved (Re, Im).
// One widening GeMM of M x 2N x 2K real operations (see main.c). M must be a multiple of 16.
{
    kernel: "CMATMUL"
    M: 64,
    N: 64,
    K: 64
}
