// DLRM-style (FP16 -> FP32): embedding-bag (gather + sum pooling in FP16) -> MLP layer (widening GeMM + bias) -> ReLU.
//   R table rows of D=64 features, B bags of L lookups each, Dout MLP outputs (multiple of 16).
{
    kernel: "GATHERMLP"
    mode: "dlrm",
    R: 256,
    D: 64,
    B: 128,
    L: 8,
    Dout: 64
}
