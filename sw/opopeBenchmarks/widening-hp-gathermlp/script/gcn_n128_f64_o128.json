// GCN layer (FP16 -> FP32; mean aggregation incl. self loop): gather-sum of the neighbour features (FP16),
// scaled by 1/(deg+1) -> widening GeMM with the layer weights + bias -> ReLU.  R = B = number of nodes,
// L = deg + 1 lookups per node (self loop first), D = input features, Dout = output features.
{
    kernel: "GATHERMLP"
    mode: "gcn",
    R: 128,
    D: 64,
    B: 128,
    L: 8,
    Dout: 128
}
