// Indexed (gather) load: a ROWS x DIM fp16 DRAM matrix (KV-cache-like) and an
// index stream of G unique, sorted indices selecting the rows to gather.

{
    kernel: "GATHER",
    ROWS: 2048,
    DIM: 128,
    G: 128,
    seed: 42,
}
