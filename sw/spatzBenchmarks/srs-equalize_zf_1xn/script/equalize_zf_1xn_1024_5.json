// Parameters for equalize_zf_1xn
{
    kernel: "EQUALIZE_ZF_1XN"
    nof_re: 1024,
    rx_ports: 5,
    tx_scaling: 1.4,
    noise_var: [0.2, 0.2, "zero", "neg", "nan"]

    special: {
        zero: 0.05, inf_re: 0.05, inf_im: 0.05,
        nan_re: 0.05, nan_im: 0.05,
        huge: 0.03, denorm: 0.03, tiny: 0.03
    }
    poison_prob: 0.8
}
